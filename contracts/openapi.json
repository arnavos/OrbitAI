                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/audit": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "List Audit Events",
        "description": "Retrieve recent immutable audit event records.",
        "operationId": "list_audit_events_api_v1_system_audit_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "x-orbit-session-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Orbit-Session-Token"
