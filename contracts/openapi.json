        "summary": "Get System Info",
        "description": "Retrieve host specifications, platform architecture, and memory capacities.",
        "operationId": "get_system_info_api_v1_system_info_get",
        "parameters": [
          {
            "name": "x-orbit-session-token",
            "in": "header",
            "required": false,
