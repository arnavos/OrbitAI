            "description": "Elapsed uptime of the backend process"
          },
          "pid": {
            "type": "integer",
            "title": "Pid",
            "description": "Operating system Process ID of the backend daemon"
          },
          "memory_rss_mb": {
            "type": "number",
            "title": "Memory Rss Mb",
            "description": "Resident Set Size memory in MB"
          },
          "cpu_percent": {
            "type": "number",
