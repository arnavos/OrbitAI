      "DetailedHealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall health status: 'healthy', 'degraded', or 'unhealthy'"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Application version"
          },
          "uptime_seconds": {
            "type": "number",
