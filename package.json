{
  "name": "orbit-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev:frontend": "pnpm --filter @orbit/frontend dev",
    "build:frontend": "pnpm --filter @orbit/frontend build",
    "test:frontend": "pnpm --filter @orbit/frontend test",
    "dev:backend": "cd backend && uv run uvicorn app.main:app --reload --port 18420 --host 127.0.0.1",
    "test:backend": "cd backend && uv run pytest -v -c pyproject.toml",
    "lint:backend": "cd backend && uv run ruff check .",
    "test": "pnpm test:frontend && pnpm test:backend",
    "lint": "pnpm --filter @orbit/frontend lint && pnpm lint:backend",
    "generate:contracts": "bash contracts/generate_types.sh",
    "tauri": "pnpm --filter @orbit/desktop tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
